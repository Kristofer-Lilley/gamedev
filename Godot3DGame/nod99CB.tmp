script/source = "extends Camera3D

var look_rot_x = 0
var look_rot_y = 0
var LOOKAROUND_SPEED = 0.01

# Called when the node enters the scene tree for the first time.
func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	look_rot_y = clamp(look_rot_y, -1, 1,)
	pass

func _keyboard_input(event):
	if Input.is_key_pressed(KEY_W):
		object.position.relative(Vector2.AXIS_X + 1)
	

func _mouse_input(event):
	if event is InputEventMouseMotion:
		# modify accumulated mouse rotation
		look_rot_x += event.relative.x * LOOKAROUND_SPEED
		look_rot_y += event.relative.y * LOOKAROUND_SPEED
		transform.basis = Basis() # reset rotation
		rotate_object_local(Vector3(0, -1, 0), look_rot_x) # first rotate in Y
		rotate_object_local(Vector3(-1, 0, 0), look_rot_y) # then rotate in X
"

