	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	_sunMovement()
	_sunBrightness()
	pass

func _sunMovement():
	var my_basis = Basis.IDENTITY
	var angle = TAU / 360
	angle = angle / 0.01666666667
	my_basis = my_basis.rotated(Vector3.RIGHT, angle)


func _sunBrightness(delta):
	var time_since_start = get_ticks_msec()
	var time_of_day = delta % 360
	time_of_day = time_of_day / 0.01666666667
